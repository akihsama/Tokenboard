# ── Required ────────────────────────────────────────────────
# Master key used to encrypt your API keys at rest (AES-256-GCM).
# Generate one with:  pnpm gen-key
# Must be a base64-encoded 32-byte value. NEVER commit this file.
TOKENBOARD_MASTER_KEY=

# ── Optional ────────────────────────────────────────────────
# Where the SQLite database + local master key live.
DATA_DIR=./data

# Cron expression for background sync (self-hosted / Docker only).
# Vercel has no long-running process — use Vercel Cron to hit /api/sync instead.
SYNC_CRON=0 */6 * * *

# HTTP port
PORT=3000
