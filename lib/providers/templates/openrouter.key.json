{
  "id": "openrouter.key",
  "name": "OpenRouter",
  "version": 1,
  "category": "balance",
  "docs": "https://openrouter.ai/docs/api-reference/limits",
  "description": "OpenRouter per-key usage, credit limit and remaining balance via /api/v1/auth/key.",
  "match": {
    "keyPrefix": "sk-or-",
    "baseUrlHint": "openrouter.ai"
  },
  "auth": {
    "type": "bearer",
    "headerName": "Authorization",
    "valueTemplate": "Bearer {{key}}"
  },
  "endpoints": [
    {
      "id": "key",
      "method": "GET",
      "baseUrl": "https://openrouter.ai/api/v1",
      "path": "/auth/key",
      "query": {},
      "headers": {},
      "pagination": { "type": "none" },
      "as": "balance"
    }
  ],
  "mapping": {
    "balance": {
      "amount": "$.data.limit_remaining",
      "currency": "$.data.currency",
      "granted": "$.data.limit",
      "topUp": "$.data.usage",
      "isAvailable": "$.data.is_free_tier",
      "coerce": {
        "amount": "number",
        "granted": "number",
        "topUp": "number"
      },
      "defaultCurrency": "USD"
    }
  },
  "supportsPerKey": true,
  "setup": {
    "note": "OpenRouter 的 key 级接口，返回该 Key 的剩余额度(limit_remaining)、总额度(limit) 与已用量(usage)。注意 is_free_tier 字段被借用来表示是否免费层。"
  }
}
